# ==============================================================================
# Unifierr Environment Configuration
# Copy this file to .env in the same folder as docker-compose.yml:
#   cp .env.example .env
# ==============================================================================

# Storage root directory where app configurations, downloads, and media files will live.
# Recommended defaults by platform:
#   - Standard Linux:  /srv/unifierr
#   - Synology DSM:    /volume1/docker/unifierr
#   - Unraid:          /mnt/user/unifierr
#   - TrueNAS SCALE:   /mnt/<your-pool>/unifierr
UNIFIERR_ROOT=/srv/unifierr
# Bind the web port to the NAS itself. Use an HTTPS reverse proxy for other devices.
UNIFIERR_BIND_ADDRESS=127.0.0.1
# Exact public service hosts to trust, comma-separated. Leave empty by default.
UNIFIERR_ALLOWED_SERVICE_HOSTS=

# User ID (PUID) and Group ID (PGID) that should own your media and config files.
# On Linux / NAS, run the command `id` in your terminal to see your UID and GID.
# Standard defaults: 1000 for regular Linux user; 99/100 on Unraid (nobody:users).
PUID=1000
PGID=1000

# Your local timezone. Used for log timestamps and automation schedules.
# Examples: America/New_York, Europe/London, Asia/Tokyo, UTC
TZ=UTC

# Docker API endpoint. Keep the default for a standard install.
# For the optional socket-proxy setup, set this to the proxy's private URL and
# remove the direct /var/run/docker.sock volume from docker-compose.yml.
UNIFIERR_DOCKER_HOST=unix:///var/run/docker.sock
